@import "tailwindcss";

@theme {
  --color-navy: #0B2745;
  --color-navy-2: #163D68;
  --color-green: #6489AD;
  --color-green-light: #8AA8C4;
  --color-yellow: #315F91;
  --color-red: #163D68;
  --color-blue: #4F8ED1;
  --color-pink: #899BC8;
  --color-paper: #F3F8FC;
  --color-ink: #16324F;
  --color-ink-soft: #60788F;
  --color-cat-cuisine: #7896AE;
  --color-cat-cuisine-light: #E4EEF7;
  --color-cat-cuisine-dark: #526F91;

  --color-cat-machine: #5FAFC8;
  --color-cat-machine-light: #E4EEF7;
  --color-cat-machine-dark: #315F91;

  --color-cat-buanderie: #69C7E3;
  --color-cat-buanderie-light: #E4EEF7;
  --color-cat-buanderie-dark: #315F91;

  --color-cat-sanitaire: #899BC8;
  --color-cat-sanitaire-light: #E4EEF7;
  --color-cat-sanitaire-dark: #526F91;

  --color-cat-communs: #526F91;
  --color-cat-communs-light: #E4EEF7;
  --color-cat-communs-dark: #163D68;

  --color-cat-piscine: #4F8ED1;
  --color-cat-piscine-light: #E4EEF7;
  --color-cat-piscine-dark: #315F91;
}

:root {
  --font-display: var(--font-space-grotesk), ui-sans-serif, system-ui, sans-serif;
  --font-editorial: var(--font-fraunces), "Times New Roman", serif;
  --font-body: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
  --font-mono: var(--font-plex-mono), ui-monospace, monospace;
  --font-script: var(--font-caveat), cursive;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--color-paper);
  color: var(--color-ink);
  font-family: var(--font-body);
  overflow-x: hidden;
  cursor: default;
}
::selection { background: var(--color-green-light); color: var(--color-navy); }
img { max-width: 100%; display: block; width: 100%; height: 100%; object-fit: cover; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ---------- Loader ---------- */
#loader { position: fixed; inset: 0; z-index: 9999; background: var(--color-navy); display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 18px; transition: opacity .8s ease, visibility .8s ease; }
#loader .blocks { display: flex; gap: 6px; }
#loader .blocks i { width: 14px; height: 14px; border-radius: 4px; opacity: 0; animation: popIn .5s ease forwards; }
#loader .blocks i:nth-child(1) { background: var(--color-yellow); animation-delay: .1s; }
#loader .blocks i:nth-child(2) { background: var(--color-red); animation-delay: .22s; }
#loader .blocks i:nth-child(3) { background: var(--color-blue); animation-delay: .34s; }
#loader .blocks i:nth-child(4) { background: var(--color-pink); animation-delay: .46s; }
@keyframes popIn { from { opacity: 0; transform: scale(.3); } to { opacity: 1; transform: scale(1); } }
#loader .mark { font-family: var(--font-display); font-weight: 700; letter-spacing: .06em; font-size: 22px; color: #fff; opacity: 0; animation: fadeIn .5s ease .5s forwards; }
#loader .bar { width: 140px; height: 2px; background: rgba(255,255,255,.15); position: relative; overflow: hidden; border-radius: 2px; }
#loader .bar span { position: absolute; inset: 0; width: 0%; background: var(--color-green-light); animation: loadFill 1.2s ease .7s forwards; }
@keyframes loadFill { to { width: 100%; } }
@keyframes fadeIn { to { opacity: 1; } }
#loader.done { opacity: 0; visibility: hidden; }

/* ---------- Cursor spotlight ---------- */
#spotlight { position: fixed; top: 0; left: 0; width: 520px; height: 520px; border-radius: 50%; pointer-events: none; z-index: 1; background: radial-gradient(circle, rgba(79,201,127,.14), transparent 70%); transform: translate(-50%, -50%); mix-blend-mode: screen; }

/* ---------- Nav ---------- */
header { position: fixed; top: 0; left: 0; right: 0; z-index: 500; display: flex; align-items: center; justify-content: space-between; padding: 18px 5vw; background: rgba(10,29,26,.4); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid rgba(255,255,255,.08); transition: background .3s ease, padding .3s ease; }
header.scrolled { padding: 12px 5vw; background: rgba(10,29,26,.85); }
.brand { display: flex; align-items: center; gap: 10px; }
.brand .blocks { display: flex; gap: 3px; }
.brand .blocks i { width: 9px; height: 9px; border-radius: 2px; }
.brand .blocks i:nth-child(1) { background: var(--color-yellow); }
.brand .blocks i:nth-child(2) { background: var(--color-red); }
.brand .blocks i:nth-child(3) { background: var(--color-blue); }
.brand .blocks i:nth-child(4) { background: var(--color-pink); }
.brand-text { font-family: var(--font-display); font-weight: 700; font-size: 19px; color: #fff; letter-spacing: .01em; }
.brand-text span { color: var(--color-green-light); }
nav.links { display: flex; gap: 34px; position: relative; }
nav.links a { color: rgba(255,255,255,.72); text-decoration: none; font-size: 14px; font-weight: 500; position: relative; padding-bottom: 4px; transition: color .25s ease; }
nav.links a:hover { color: #fff; }
#nav-indicator { position: absolute; bottom: -1px; height: 1px; background: linear-gradient(90deg, var(--color-green-light), var(--color-yellow)); width: 0; transition: left .35s cubic-bezier(.16,1,.3,1), width .35s cubic-bezier(.16,1,.3,1); }
.cta-pill { font-family: var(--font-display); font-weight: 600; font-size: 13px; background: var(--color-green-light); color: var(--color-navy); padding: 11px 22px; border-radius: 999px; border: none; cursor: pointer; letter-spacing: .02em; display: inline-block; }
.nav-mobile-hide { display: flex; }
@media (max-width: 900px) { .nav-mobile-hide { display: none; } }
.magnetic { position: relative; }

/* ---------- Photo frame w/ duotone ---------- */
.photo-frame { position: relative; overflow: hidden; }
.photo-frame img { filter: grayscale(.35) contrast(1.05); transform: scale(1.15); will-change: transform; }
.photo-frame .tint { position: absolute; inset: 0; mix-blend-mode: multiply; opacity: .6; }
.photo-frame .tint-top { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.15), rgba(0,0,0,.55)); }

/* ---------- Hero ---------- */
#hero { position: relative; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: var(--color-navy); overflow: hidden; padding: 130px 20px 70px; }
#hero .photo-frame { position: absolute; inset: 0; z-index: 0; }
#hero .photo-frame .tint { background: linear-gradient(135deg, rgba(10,29,26,.75), rgba(15,43,36,.55)); }
.layer-field { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
.layer-block { position: absolute; width: 20px; height: 20px; border-radius: 6px; opacity: .6; will-change: transform; box-shadow: 0 12px 30px rgba(0,0,0,.25); }

.tilt-target { --mx: 50%; --my: 50%; position: relative; }
.tilt-target::before { content: ""; position: absolute; inset: 0; z-index: 1; background: radial-gradient(220px circle at var(--mx) var(--my), rgba(255,255,255,.35), transparent 60%); opacity: 0; transition: opacity .35s ease; pointer-events: none; border-radius: inherit; }
.tilt-target:hover::before { opacity: 1; }
.value-card.tilt-target::before { background: radial-gradient(220px circle at var(--mx) var(--my), rgba(46,158,91,.16), transparent 60%); }

.eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: var(--color-green-light); opacity: .9; margin-bottom: 20px; z-index: 2; position: relative; }
.hero-headline { z-index: 2; position: relative; display: flex; align-items: baseline; gap: .28em; flex-wrap: wrap; justify-content: center; font-family: var(--font-editorial); font-weight: 500; color: #fff; font-size: clamp(48px, 9vw, 116px); line-height: .95; letter-spacing: -.01em; }
.hero-headline .word { display: inline-block; opacity: 0; }
.hero-headline .right { color: var(--color-green-light); }
.hero-script { z-index: 2; position: relative; font-family: var(--font-script); font-size: 26px; color: var(--color-green-light); opacity: 0; margin-top: 2px; }
.hero-divider { width: 60px; height: 2px; margin: 24px auto; z-index: 2; position: relative; background: linear-gradient(90deg, transparent, var(--color-green-light), transparent); opacity: 0; }
.hero-sub { z-index: 2; position: relative; max-width: 560px; color: rgba(246,249,246,.78); font-size: 17px; line-height: 1.6; opacity: 0; margin: 0 auto; }
.hero-ctas { z-index: 2; position: relative; display: flex; gap: 16px; margin-top: 36px; opacity: 0; flex-wrap: wrap; justify-content: center; }
.btn-solid { font-family: var(--font-display); font-weight: 600; font-size: 14px; background: linear-gradient(135deg, var(--color-green-light), var(--color-green)); color: #fff; padding: 14px 28px; border-radius: 999px; border: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; transition: transform .4s cubic-bezier(.2,.8,.2,1), box-shadow .4s ease; will-change: transform; }
.btn-solid:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 14px 30px rgba(46,158,91,.35); }
.btn-outline { font-family: var(--font-display); font-weight: 600; font-size: 14px; background: transparent; color: #fff; padding: 14px 26px; border-radius: 999px; border: 1px solid rgba(255,255,255,.35); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; transition: transform .4s cubic-bezier(.2,.8,.2,1), background .35s ease, border-color .35s ease; will-change: transform; }
.btn-outline:hover { transform: translateY(-3px) scale(1.03); background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.6); }
.badge-clean { z-index: 2; position: absolute; top: 150px; right: 6vw; display: flex; flex-direction: column; align-items: center; gap: 6px; opacity: 0; }
.badge-clean .ring { width: 74px; height: 74px; border-radius: 50%; border: 2px solid var(--color-green-light); display: flex; align-items: center; justify-content: center; position: relative; animation: pulseRing 2.4s ease-in-out infinite; }
@keyframes pulseRing { 0%, 100% { box-shadow: 0 0 0 0 rgba(79,201,127,.35); } 50% { box-shadow: 0 0 0 10px rgba(79,201,127,0); } }
.badge-clean .pct { font-family: var(--font-display); font-weight: 700; color: #fff; font-size: 15px; }
.badge-clean .lbl { font-family: var(--font-mono); font-size: 10px; letter-spacing: .15em; color: rgba(255,255,255,.6); }
@media (max-width: 800px) { .badge-clean { display: none; } }
.scroll-cue { position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); z-index: 2; width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(255,255,255,.25); display: flex; align-items: center; justify-content: center; color: #fff; opacity: .7; animation: bounce 2.2s ease-in-out infinite; }
@keyframes bounce { 0%, 100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, 6px); } }

/* ---------- Marquee ---------- */
.marquee-wrap { background: var(--color-navy-2); padding: 20px 0; overflow: hidden; border-top: 1px solid rgba(255,255,255,.06); border-bottom: 1px solid rgba(255,255,255,.06); }
.marquee { display: flex; gap: 52px; white-space: nowrap; width: max-content; animation: marquee 26s linear infinite; }
.marquee span { font-family: var(--font-mono); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.55); }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

section { padding: 110px 8vw; position: relative; }
.section-head { max-width: 640px; margin: 0 auto 56px; text-align: center; }
.section-eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: var(--color-green); margin-bottom: 16px; }
.section-title { font-family: var(--font-editorial); font-size: clamp(30px, 4.5vw, 50px); font-weight: 500; color: var(--color-ink); line-height: 1.1; }
.section-sub { margin-top: 16px; color: var(--color-ink-soft); font-size: 16px; line-height: 1.7; }
.reveal { opacity: 0; }
.reveal-3d { opacity: 0; }

/* ---------- Stats ---------- */
#stats { background: var(--color-navy); }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 36px; max-width: 1100px; margin: 0 auto; perspective: 1200px; }
.stat { text-align: center; }
.stat .num { font-family: var(--font-display); font-size: clamp(34px, 4vw, 52px); font-weight: 700; color: #fff; }
.stat .num span { color: var(--color-green-light); }
.stat .label { margin-top: 8px; font-size: 13px; color: rgba(255,255,255,.55); letter-spacing: .02em; }
@media (max-width: 760px) { .stats-grid { grid-template-columns: repeat(2, 1fr); row-gap: 40px; } }

/* ---------- About ---------- */
#about .about-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; max-width: 1180px; margin: 0 auto 70px; }
#about .about-photo { border-radius: 24px; height: 420px; }
#about .about-photo .tint { background: linear-gradient(160deg, rgba(46,158,91,.35), rgba(10,29,26,.35)); }
#about .about-text { text-align: left; }
#about .about-text .section-eyebrow { margin-bottom: 14px; }
@media (max-width: 900px) { #about .about-wrap { grid-template-columns: 1fr; } #about .about-photo { height: 280px; } }

.values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px; max-width: 1180px; margin: 0 auto; }
.value-card { background: #fff; border: 1px solid rgba(14,31,26,.06); border-radius: 20px; padding: 30px 24px; box-shadow: 0 1px 2px rgba(14,31,26,.04); }
.value-card .idx { font-family: var(--font-mono); font-size: 12px; color: var(--color-green); margin-bottom: 14px; }
.value-card h3 { font-family: var(--font-display); font-size: 17px; margin-bottom: 10px; }
.value-card p { font-size: 14px; color: var(--color-ink-soft); line-height: 1.6; }
@media (max-width: 900px) { .values-grid { grid-template-columns: repeat(2, 1fr); } }

/* ---------- Category banners ---------- */
.cat-grid-banners { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; max-width: 1180px; margin: 0 auto; perspective: 1400px; }
@media (max-width: 900px) { .cat-grid-banners { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { .cat-grid-banners { grid-template-columns: 1fr; } }
.cat-banner {
  --cat: var(--color-blue);
  --cat-light: rgba(100,137,173,.12);
  --cat-dark: #315F91;
  position: relative; border-radius: 26px; min-height: 280px; display: flex; align-items: flex-end; padding: 34px; cursor: pointer; transform-style: preserve-3d;
  background: linear-gradient(145deg, var(--cat), var(--cat-dark));
  box-shadow: 0 18px 40px color-mix(in srgb, var(--cat) 22%, transparent);
}

/* CatÃƒÂ©gories : mÃƒÂªmes teintes que les sÃƒÂ©parateurs du catalogue PDF */
.cat-banner.cuisine, .cat-banner[data-category="cuisine"],
.product-card.cuisine, .product-card[data-category="cuisine"],
.hslide-col.cuisine, .hslide-col[data-category="cuisine"] { --cat: var(--color-cat-cuisine); --cat-light: var(--color-cat-cuisine-light); --cat-dark: var(--color-cat-cuisine-dark); }

.cat-banner.machine, .cat-banner[data-category="machine"],
.product-card.machine, .product-card[data-category="machine"],
.hslide-col.machine, .hslide-col[data-category="machine"] { --cat: var(--color-cat-machine); --cat-light: var(--color-cat-machine-light); --cat-dark: var(--color-cat-machine-dark); }

.cat-banner.buanderie, .cat-banner[data-category="buanderie"],
.product-card.buanderie, .product-card[data-category="buanderie"],
.hslide-col.buanderie, .hslide-col[data-category="buanderie"] { --cat: var(--color-cat-buanderie); --cat-light: var(--color-cat-buanderie-light); --cat-dark: var(--color-cat-buanderie-dark); }

.cat-banner.sanitaire, .cat-banner[data-category="sanitaire"],
.product-card.sanitaire, .product-card[data-category="sanitaire"],
.hslide-col.sanitaire, .hslide-col[data-category="sanitaire"] { --cat: var(--color-cat-sanitaire); --cat-light: var(--color-cat-sanitaire-light); --cat-dark: var(--color-cat-sanitaire-dark); }

.cat-banner.communs, .cat-banner[data-category="communs"],
.product-card.communs, .product-card[data-category="communs"],
.hslide-col.communs, .hslide-col[data-category="communs"] { --cat: var(--color-cat-communs); --cat-light: var(--color-cat-communs-light); --cat-dark: var(--color-cat-communs-dark); }

.cat-banner.piscine, .cat-banner[data-category="piscine"],
.product-card.piscine, .product-card[data-category="piscine"],
.hslide-col.piscine, .hslide-col[data-category="piscine"] { --cat: var(--color-cat-piscine); --cat-light: var(--color-cat-piscine-light); --cat-dark: var(--color-cat-piscine-dark); }
.cat-banner.tilt-target::before { background: radial-gradient(280px circle at var(--mx) var(--my), rgba(255,255,255,.28), transparent 60%); z-index: 1; }
.cat-banner .label { position: relative; z-index: 2; transition: transform .4s ease; }
.cat-banner:hover .label { transform: translateY(-4px); }
.cat-banner .label .kicker { font-family: var(--font-mono); font-size: 11px; letter-spacing: .25em; text-transform: uppercase; color: rgba(255,255,255,.8); margin-bottom: 8px; }
.cat-banner .label h3 { font-family: var(--font-display); font-weight: 700; font-size: clamp(22px, 2.6vw, 32px); color: #fff; }
.cat-banner .label p { color: rgba(255,255,255,.8); font-size: 13.5px; margin-top: 8px; max-width: 420px; }
.cat-banner .arrow-badge { position: absolute; top: 24px; right: 24px; z-index: 2; width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.3); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 16px; opacity: 0; transform: translate(-6px, 6px); transition: opacity .3s ease, transform .3s ease; }
.cat-banner:hover .arrow-badge { opacity: 1; transform: translate(0, 0); }

/* ---------- Category surfaces / catalogue harmony ---------- */
.product-card .card-face.back {
  background: linear-gradient(145deg, var(--cat), var(--cat-dark));
}

.cat-filter-btn[data-category], .cat-filter-btn.cuisine, .cat-filter-btn.machine,
.cat-filter-btn.buanderie, .cat-filter-btn.sanitaire, .cat-filter-btn.communs, .cat-filter-btn.piscine {
  --cat: var(--color-blue);
  --cat-light: rgba(100,137,173,.12);
}
.cat-filter-btn.cuisine, .cat-filter-btn[data-category="cuisine"] { --cat: var(--color-cat-cuisine); --cat-light: var(--color-cat-cuisine-light); }
.cat-filter-btn.machine, .cat-filter-btn[data-category="machine"] { --cat: var(--color-cat-machine); --cat-light: var(--color-cat-machine-light); }
.cat-filter-btn.buanderie, .cat-filter-btn[data-category="buanderie"] { --cat: var(--color-cat-buanderie); --cat-light: var(--color-cat-buanderie-light); }
.cat-filter-btn.sanitaire, .cat-filter-btn[data-category="sanitaire"] { --cat: var(--color-cat-sanitaire); --cat-light: var(--color-cat-sanitaire-light); }
.cat-filter-btn.communs, .cat-filter-btn[data-category="communs"] { --cat: var(--color-cat-communs); --cat-light: var(--color-cat-communs-light); }
.cat-filter-btn.piscine, .cat-filter-btn[data-category="piscine"] { --cat: var(--color-cat-piscine); --cat-light: var(--color-cat-piscine-light); }

.cat-filter-btn.active, .cat-filter-btn:hover {
  border-color: var(--cat);
  color: var(--cat-dark, var(--color-ink));
  background: var(--cat-light);
}

/* ---------- Columns slider ---------- */
.hslide-pin { height: 100vh; display: flex; flex-direction: column; justify-content: center; background: var(--color-paper); overflow: hidden; }
.hslide-head { text-align: center; margin-bottom: 50px; padding: 0 8vw; }
.hslide-track { display: flex; gap: 26px; width: max-content; padding: 0 8vw; perspective: 1400px; }
.hslide-col { --c: var(--cat, #6489AD); width: 320px; height: 340px; border-radius: 24px; background: #fff; border: 1px solid rgba(14,31,26,.07); padding: 32px; flex-shrink: 0; position: relative; overflow: hidden; box-shadow: 0 1px 2px rgba(14,31,26,.04); transition: box-shadow .4s ease; will-change: transform; }
.hslide-col:hover { box-shadow: 0 24px 48px rgba(14,31,26,.16); }
.hslide-col::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 5px; background: var(--c); }
.hslide-num { font-family: var(--font-display); font-weight: 700; font-size: 42px; color: var(--c); opacity: .35; }
.hslide-col h3 { font-family: var(--font-display); font-size: 19px; margin-top: 16px; margin-bottom: 12px; }
.hslide-col p { font-size: 14px; color: var(--color-ink-soft); line-height: 1.6; }
@media (max-width: 699px) { .hslide-pin { height: auto; padding: 90px 0; } .hslide-track { overflow-x: auto; padding-bottom: 20px; } }

/* ---------- Catalogue ---------- */
#catalogue { background: var(--color-paper); }
.cat-filters { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-bottom: 44px; position: sticky; top: 80px; z-index: 50; background: rgba(246,249,246,.9); backdrop-filter: blur(6px); padding: 10px 0; }
.cat-filter-btn { font-family: var(--font-display); font-size: 13px; font-weight: 600; padding: 10px 18px; border-radius: 999px; border: 1px solid rgba(14,31,26,.15); background: #fff; color: var(--color-ink-soft); cursor: pointer; transition: all .25s ease; }
.product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 1200px; margin: 0 auto; perspective: 1200px; }
@media (max-width: 960px) { .product-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 640px) { .product-grid { grid-template-columns: 1fr; } }
.product-card { --cat: #6489AD; height: 210px; position: relative; }
.card-inner { position: relative; width: 100%; height: 100%; transition: transform .6s cubic-bezier(.16,1,.3,1); transform-style: preserve-3d; }
.product-card:hover .card-inner { transform: rotateY(180deg); }
.card-face { position: absolute; inset: 0; backface-visibility: hidden; border-radius: 18px; background: #fff; border: 1px solid rgba(14,31,26,.07); padding: 22px; overflow: hidden; }
.card-face.front::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--cat); z-index: 2; }
.card-face.front::after { content: ""; position: absolute; top: 0; left: -160%; width: 55%; height: 100%; background: linear-gradient(115deg, transparent, rgba(255,255,255,.55), transparent); transform: skewX(-20deg); transition: left .75s ease; pointer-events: none; }
.product-card:hover .card-face.front::after { left: 160%; }
.card-face .code { font-family: var(--font-display); font-weight: 700; font-size: 22px; color: var(--cat); }
.card-face .name { font-family: var(--font-display); font-weight: 600; font-size: 14px; color: var(--color-ink); margin-top: 2px; text-transform: uppercase; letter-spacing: .02em; }
.card-face .meta { display: flex; gap: 10px; margin-top: 10px; font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-soft); }
.card-face .meta b { color: var(--color-ink); }
.card-face .desc { margin-top: 12px; font-size: 13px; color: var(--color-ink-soft); line-height: 1.5; }
.card-face.back { transform: rotateY(180deg); background: var(--cat); color: #fff; display: flex; flex-direction: column; justify-content: center; }
.card-face.back .lbl { font-family: var(--font-mono); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; opacity: .75; margin-bottom: 10px; }
.card-face.back .dosage { font-family: var(--font-mono); font-size: 13px; line-height: 1.7; }

/* ---------- Timeline ---------- */
#process { background: var(--color-navy); }
#process .section-title, #process .section-sub { color: #fff; }
#process .section-sub { color: rgba(255,255,255,.6); }
.timeline { position: relative; max-width: 1000px; margin: 70px auto 0; display: flex; justify-content: space-between; }
.timeline .line-track { position: absolute; top: 11px; left: 0; right: 0; height: 1px; background: rgba(255,255,255,.15); }
.timeline .line-fill { position: absolute; top: 11px; left: 0; height: 1px; width: 0%; background: linear-gradient(90deg, var(--color-green-light), var(--color-yellow)); }
.tl-node { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; width: 16.5%; text-align: center; }
.tl-node .dot { width: 24px; height: 24px; border-radius: 50%; background: var(--color-navy-2); border: 2px solid rgba(255,255,255,.25); transition: border-color .4s ease, background .4s ease, box-shadow .4s ease; }
.tl-node.active .dot { border-color: var(--color-green-light); background: var(--color-green-light); box-shadow: 0 0 24px rgba(79,201,127,.6); }
.tl-node .tl-label { margin-top: 16px; font-family: var(--font-display); font-size: 13px; font-weight: 600; color: rgba(255,255,255,.5); transition: color .4s ease; }
.tl-node.active .tl-label { color: #fff; }
@media (max-width: 800px) { .timeline { flex-wrap: wrap; row-gap: 40px; } .tl-node { width: 30%; } .timeline .line-track, .timeline .line-fill { display: none; } }

/* ---------- CTA banner ---------- */
#cta-banner { margin: 0 8vw 110px; border-radius: 28px; padding: 90px 40px; text-align: center; position: relative; min-height: 340px; display: flex; flex-direction: column; align-items: center; justify-content: center; perspective: 1400px; }
#cta-banner .tint { background: linear-gradient(135deg, rgba(10,29,26,.88), rgba(15,43,36,.75)); }
#cta-banner h2 { font-family: var(--font-editorial); color: #fff; font-size: clamp(28px, 4vw, 42px); font-weight: 500; max-width: 640px; margin: 0 auto 18px; position: relative; z-index: 2; }
#cta-banner p { color: rgba(255,255,255,.7); max-width: 480px; margin: 0 auto 32px; font-size: 15px; position: relative; z-index: 2; }
#cta-banner .row { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; position: relative; z-index: 2; }

/* ---------- Footer ---------- */
footer { background: var(--color-navy-2); color: rgba(255,255,255,.6); padding: 64px 8vw 28px; }
.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1.4fr; gap: 40px; padding-bottom: 44px; border-bottom: 1px solid rgba(255,255,255,.08); }
.footer-grid h4 { font-family: var(--font-display); color: #fff; font-size: 13px; letter-spacing: .05em; text-transform: uppercase; margin-bottom: 16px; }
.footer-grid a { display: block; color: rgba(255,255,255,.55); text-decoration: none; font-size: 14px; margin-bottom: 10px; transition: color .25s ease; }
.footer-grid a:hover { color: var(--color-green-light); }
.footer-logo { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
.footer-logo .brand-text { font-size: 20px; }
.footer-grid p { font-size: 14px; line-height: 1.7; max-width: 280px; }
.newsletter { display: flex; margin-top: 16px; border: 1px solid rgba(255,255,255,.15); border-radius: 999px; overflow: hidden; max-width: 280px; }
.newsletter input { flex: 1; background: transparent; border: none; padding: 10px 16px; color: #fff; font-size: 13px; outline: none; }
.newsletter button { background: var(--color-green-light); border: none; padding: 0 18px; font-family: var(--font-display); font-weight: 600; font-size: 12px; cursor: pointer; }
.footer-bottom { display: flex; justify-content: space-between; align-items: center; padding-top: 22px; font-size: 12px; flex-wrap: wrap; gap: 12px; }

/* ================= hero video: sole hero visual, 3D entrance + parallax ================= */
#hero .photo-frame { perspective: 1400px; }
.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  opacity: 1;
  filter: grayscale(.15) contrast(1.05) saturate(1.05);
  will-change: transform, opacity;
  backface-visibility: hidden;
}
#hero .photo-frame .tint { z-index: 2; }

/* ================= product spotlight ================= */
#spotlight-product { padding: 100px 8vw; overflow: hidden; }
.spotlight-wrap {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 64px;
  align-items: center;
  max-width: 1240px;
  margin: 0 auto;
  perspective: 1400px;
}
.spotlight-visual {
  position: relative;
  min-height: 460px;
  border-radius: 32px;
  background: radial-gradient(120% 120% at 30% 20%, #12332a 0%, var(--color-navy) 70%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transform-style: preserve-3d;
  --mx: 50%; --my: 50%;
}
.spotlight-visual::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  background: radial-gradient(320px circle at var(--mx) var(--my), rgba(255,255,255,.28), transparent 60%);
  opacity: 0;
  transition: opacity .35s ease;
  pointer-events: none;
}
.spotlight-visual:hover::before { opacity: 1; }
.spotlight-glow {
  position: absolute;
  width: 60%;
  height: 60%;
  background: radial-gradient(circle, rgba(79,201,127,.35), transparent 70%);
  filter: blur(30px);
  z-index: 0;
}
.spotlight-bottle {
  position: relative;
  z-index: 1;
  max-width: 62%;
  max-height: 82%;
  object-fit: contain;
  filter: drop-shadow(0 30px 40px rgba(0,0,0,.45));
  transform: translateZ(40px);
}
.spotlight-layer {
  position: absolute;
  width: auto;
  height: auto;
  border-radius: 999px;
  padding: 9px 16px;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .04em;
  color: #fff;
  box-shadow: 0 14px 30px rgba(0,0,0,.35);
  z-index: 3;
  opacity: 0;
  white-space: nowrap;
  pointer-events: none;
}
.spotlight-text .section-title { margin-bottom: 16px; }
.spotlight-list { list-style: none; padding: 0; margin: 22px 0 26px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 20px; }
.spotlight-list li { font-size: 14.5px; color: var(--color-ink-soft); padding-left: 22px; position: relative; }
.spotlight-list li::before { content: "Ã¢Å“â€œ"; position: absolute; left: 0; color: var(--color-green); font-weight: 700; }
.spotlight-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 30px; }
.spotlight-tags span { font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; padding: 7px 13px; border-radius: 999px; background: rgba(46,158,91,.08); color: var(--color-green); border: 1px solid rgba(46,158,91,.18); }
@media (max-width: 860px) {
  .spotlight-wrap { grid-template-columns: 1fr; }
  .spotlight-visual { min-height: 340px; }
  .spotlight-list { grid-template-columns: 1fr; }
}

/* ================= gallery columns slider (scrub, hover light, 3D tilt) ================= */
.gslide-pin { height: 100vh; display: flex; flex-direction: column; justify-content: center; background: var(--color-navy); overflow: hidden; }
.gslide-head { text-align: center; margin-bottom: 46px; padding: 0 8vw; }
.gslide-head .section-title, .gslide-head .section-eyebrow { color: #fff; }
.gslide-head .section-title { color: #fff; }
.gslide-track { display: flex; gap: 24px; width: max-content; padding: 0 8vw; perspective: 1200px; }
.gslide-col {
  --mx: 50%; --my: 50%;
  position: relative;
  width: 300px;
  height: 400px;
  border-radius: 22px;
  overflow: hidden;
  flex-shrink: 0;
  cursor: pointer;
  box-shadow: 0 24px 50px rgba(0,0,0,.35);
  transform-style: preserve-3d;
}
.gslide-col img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.02); transition: transform .6s ease; }
.gslide-col:hover img { transform: scale(1.1); }
.gslide-col::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,29,26,0) 40%, rgba(10,29,26,.85) 100%); }
.gslide-shine {
  position: absolute;
  inset: 0;
  z-index: 2;
  background: radial-gradient(260px circle at var(--mx) var(--my), rgba(255,255,255,.35), transparent 60%);
  opacity: 0;
  transition: opacity .35s ease;
  pointer-events: none;
  mix-blend-mode: overlay;
}
.gslide-col:hover .gslide-shine { opacity: 1; }
.gslide-caption { position: absolute; left: 20px; bottom: 18px; right: 20px; z-index: 3; display: flex; align-items: baseline; gap: 10px; color: #fff; }
.gslide-caption .idx { font-family: var(--font-mono); font-size: 12px; color: var(--color-green-light); }
.gslide-caption span:last-child { font-family: var(--font-display); font-weight: 600; font-size: 16px; }
@media (max-width: 699px) {
  .gslide-pin { height: auto; padding: 70px 0; }
  .gslide-track { overflow-x: auto; padding-bottom: 20px; }
  .gslide-col { width: 240px; height: 320px; }
}

/* ================================================================
 * Additive effects Ã¢â‚¬â€ new sections/components layered on top of the
 * existing system above. Nothing here overrides GSAP-driven classes
 * (.magnetic, .tilt-target, .reveal, .reveal-3d, #loader, #spotlight).
 * ================================================================ */

/* Mobile nav */
.nav-mobile-only { display: none; color: #fff; }
@media (max-width: 900px) { .nav-mobile-only { display: inline-flex; } }
.mobile-nav {
  position: fixed; top: 74px; left: 16px; right: 16px; z-index: 998;
  background: var(--color-navy-2); border: 1px solid rgba(255,255,255,.1);
  border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 4px;
  box-shadow: 0 20px 50px rgba(0,0,0,.35);
}
.mobile-nav a {
  color: rgba(255,255,255,.85); text-decoration: none; padding: 10px 8px;
  font-family: var(--font-display); font-size: 14px; border-radius: 8px;
}
.mobile-nav a:hover { background: rgba(255,255,255,.06); color: var(--color-green-light); }

/* Bonus stats row */
.stats-extra {
  display: flex; align-items: center; justify-content: center; gap: 40px;
  margin-top: 40px; flex-wrap: wrap;
}
.stats-extra-number {
  font-family: var(--font-display); font-weight: 700; color: #fff;
  font-size: clamp(34px, 5vw, 56px);
}

/* 3D product showcase section */
#product-3d { background: var(--color-paper); text-align: center; }
#product-3d .section-head { max-width: 640px; margin: 0 auto 20px; }

/* Avant/AprÃƒÂ¨s + masonry gallery */
#gallery-alt { background: var(--color-paper); }
#gallery-alt .ba-demo { max-width: 720px; margin: 0 auto 48px; box-shadow: 0 30px 60px rgba(0,0,0,.15); }
#gallery-alt .masonry-demo { max-width: 1100px; margin: 0 auto; }

/* FAQ */
#faq { background: var(--color-navy); }
#faq .section-head { color: #fff; }
#faq .section-title { color: #fff; }
.faq-list { max-width: 760px; margin: 0 auto; color: rgba(255,255,255,.75); }
.faq-list p { line-height: 1.7; }

/* Newsletter Ã¢â‚¬â€ adapted for the floating-label/checkbox form */
.newsletter {
  display: flex; flex-direction: column; gap: 14px; margin-top: 18px;
  border: none; border-radius: 0; overflow: visible; max-width: 320px;
}
.newsletter input { padding: 0; }
.newsletter-consent { display: flex; align-items: center; gap: 10px; font-size: 12px; color: rgba(255,255,255,.6); }
.newsletter button[type="submit"] {
  align-self: flex-start; background: var(--color-green-light); color: var(--color-navy);
  border: none; border-radius: 999px; padding: 10px 22px; font-family: var(--font-display);
  font-weight: 600; font-size: 12px; cursor: pointer;
}
/* ============================================================
   PROLINE Ã¢â‚¬â€ BLUE CATALOGUE SYSTEM
   Photos for category sections can be supplied with:
   style="--cat-photo:url('/images/cuisine.jpg')"
   ============================================================ */
.cat-banner,
.hslide-col {
  background-image:
    linear-gradient(145deg, color-mix(in srgb, var(--cat) 78%, transparent), color-mix(in srgb, var(--cat-dark) 86%, #0B2745 14%)),
    var(--cat-photo, none);
  background-size: cover;
  background-position: center;
}
.cat-banner .label, .hslide-col > * { text-shadow: 0 2px 12px rgba(11,39,69,.28); }

.section-photo {
  position: relative;
  overflow: hidden;
  min-height: 420px;
  border-radius: 28px;
  background:
    linear-gradient(145deg, color-mix(in srgb, var(--cat) 42%, transparent), color-mix(in srgb, var(--cat-dark) 72%, #0B2745 28%)),
    var(--section-photo, none);
  background-size: cover;
  background-position: center;
}
.section-photo::after {
  content: "";
  position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 35%, rgba(11,39,69,.72) 100%);
  pointer-events: none;
}

/* =========================================================
   PROLINE - CATALOGUE
   ========================================================= */

.proline-catalogue {
  position: relative;
  padding: 110px 24px;
  overflow: hidden;
  background:
    radial-gradient(circle at 10% 10%, rgba(79, 142, 209, .10), transparent 35%),
    radial-gradient(circle at 90% 90%, rgba(31, 122, 90, .08), transparent 35%),
    #f7fafc;
}

.catalogue-container {
  width: min(1220px, 100%);
  margin: 0 auto;
}

.catalogue-head {
  max-width: 760px;
  margin: 0 auto 42px;
  text-align: center;
}

.catalogue-eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 7px 15px;
  border-radius: 999px;
  background: rgba(49, 95, 145, .09);
  color: #315F91;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .18em;
  margin-bottom: 18px;
}

.catalogue-head h2 {
  margin: 0;
  color: #0B2745;
  font-size: clamp(32px, 4vw, 52px);
  line-height: 1.08;
  letter-spacing: -.035em;
}

.catalogue-head h2 span {
  color: #4F8ED1;
}

.catalogue-head p {
  margin: 18px auto 0;
  max-width: 650px;
  color: #60758a;
  font-size: 16px;
  line-height: 1.7;
}

.catalogue-filters {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-bottom: 42px;
}

.catalogue-filter {
  border: 1px solid #d6e0e9;
  background: #fff;
  color: #31516e;
  border-radius: 999px;
  padding: 11px 19px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: all .25s ease;
}

.catalogue-filter:hover {
  transform: translateY(-2px);
  border-color: #4F8ED1;
  box-shadow: 0 8px 22px rgba(11, 39, 69, .09);
}

.catalogue-filter.is-active {
  color: #fff;
  box-shadow: 0 9px 25px rgba(11, 39, 69, .16);
}

.catalogue-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 25px;
}

.catalogue-card {
  height: 475px;
  perspective: 1400px;
  --card-color: #4F8ED1;
}

.catalogue-card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform .75s cubic-bezier(.2,.75,.2,1);
}

.catalogue-card:hover .catalogue-card-inner {
  transform: rotateY(180deg);
}

.catalogue-front,
.catalogue-back {
  position: absolute;
  inset: 0;
  overflow: hidden;
  border-radius: 25px;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  background: #fff;
  box-shadow: 0 18px 50px rgba(11, 39, 69, .11);
  border: 1px solid rgba(11, 39, 69, .07);
}

.catalogue-front {
  display: flex;
  flex-direction: column;
}

.catalogue-image {
  position: relative;
  height: 245px;
  overflow: hidden;
  background: #dfeaf2;
}

.catalogue-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform .6s ease;
}

.catalogue-card:hover .catalogue-image img {
  transform: scale(1.05);
}

.catalogue-image-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(11, 39, 69, .65),
    transparent 60%
  );
}

.catalogue-category,
.catalogue-code {
  position: absolute;
  z-index: 50;
  top: 16px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 32px;
  padding: 8px 13px;

  border-radius: 999px;

  color: #ffffff !important;
  background-color: #0B2745;

  font-size: 12px;
  line-height: 1;
  font-weight: 900;
  letter-spacing: .03em;

  white-space: nowrap;

  opacity: 1 !important;
  visibility: visible !important;

  text-shadow: 0 1px 3px rgba(0,0,0,.45);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);

  pointer-events: none;
}

.catalogue-category {
  left: 16px;
  background: var(--card-color) !important;
}

.catalogue-code {
  right: 16px;
  background: rgba(11, 39, 69, .92) !important;
  border: 1px solid rgba(255,255,255,.30);
}

.catalogue-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 23px;
}

.catalogue-content h3 {
  margin: 0;
  color: #0B2745;
  font-size: 20px;
  line-height: 1.25;
}

.catalogue-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 14px 0;
  padding: 10px 12px;
  border-radius: 12px;
  background: #f3f7fb;
  border: 1px solid rgba(11, 39, 69, .08);
  color: #718396;
  font-size: 12px;
  font-weight: 600;
}

.catalogue-meta span:first-child {
  display: flex;
  align-items: center;
  gap: 5px;
}

.catalogue-meta strong {
  color: var(--card-color);
  font-size: 13px;
  font-weight: 900;
}

.catalogue-content p {
  margin: 0;
  color: #63768a;
  font-size: 13px;
  line-height: 1.65;
}

.catalogue-hint {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: auto;
  padding-top: 17px;
  color: var(--card-color);
  font-size: 11px;
  font-weight: 800;
}

.catalogue-hint span {
  font-size: 17px;
}

.catalogue-back {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 35px;
  text-align: center;
  transform: rotateY(180deg);
  background:
    radial-gradient(circle at top right, rgba(255,255,255,.18), transparent 30%),
    var(--card-color);
  color: #fff;
}

.back-icon {
  display: grid;
  width: 62px;
  height: 62px;
  place-items: center;
  margin-bottom: 22px;
  border: 1px solid rgba(255,255,255,.3);
  border-radius: 50%;
  background: rgba(255,255,255,.14);
  font-size: 26px;
}

.back-label {
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .2em;
  opacity: .8;
}

.catalogue-back h3 {
  max-width: 310px;
  margin: 14px 0 22px;
  font-size: 24px;
  line-height: 1.2;
}

.dosage-box {
  width: 100%;
  padding: 18px;
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 15px;
  background: rgba(255,255,255,.12);
  font-size: 14px;
  line-height: 1.65;
}

.back-category {
  margin-top: 22px;
  padding: 7px 13px;
  border: 1px solid rgba(255,255,255,.3);
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
}

/* TABLET */
@media (max-width: 1000px) {
  .catalogue-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* MOBILE */
@media (max-width: 650px) {
  .proline-catalogue {
    padding: 75px 16px;
  }

  .catalogue-head {
    margin-bottom: 30px;
  }

  .catalogue-filters {
    justify-content: flex-start;
    overflow-x: auto;
    flex-wrap: nowrap;
    padding: 4px 2px 12px;
  }

  .catalogue-filter {
    flex: 0 0 auto;
  }

  .catalogue-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .catalogue-card {
    height: 460px;
  }
}




/* PROLINE - CATEGORIES HOME : CATEGORIE + REFERENCE */

.category-visible {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 10px;
}

.category-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 30px;
  height: 30px;
  padding: 0 9px;
  border-radius: 999px;
  background: rgba(255,255,255,.22);
  border: 1px solid rgba(255,255,255,.35);
  color: #fff;
  font-size: 11px;
  font-weight: 900;
}

.category-name {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 7px 12px;
  border-radius: 999px;
  background: rgba(255,255,255,.96);
  color: #0B2745;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .02em;
}

.category-ref {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 7px 12px;
  border-radius: 999px;
  background: rgba(11,39,69,.90);
  border: 1px solid rgba(255,255,255,.30);
  color: #fff;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .03em;
}

/* ============================================================
   PROLINE LAB â€” BLUE SYSTEM HARMONIZATION
   Couche additive : conserve les composants existants
   ============================================================ */

:root {
  --proline-navy: #0B2745;
  --proline-navy-2: #163D68;
  --proline-blue: #4F8ED1;
  --proline-blue-mid: #6489AD;
  --proline-blue-light: #8AA8C4;
  --proline-blue-soft: #E4EEF7;
  --proline-blue-dark: #315F91;
  --proline-lavender: #899BC8;
  --proline-paper: #F3F8FC;
  --proline-white: #FFFFFF;

  --proline-border: rgba(11, 39, 69, .10);
  --proline-border-strong: rgba(11, 39, 69, .16);

  --proline-shadow-sm: 0 4px 14px rgba(11, 39, 69, .07);
  --proline-shadow-md: 0 14px 36px rgba(11, 39, 69, .11);
  --proline-shadow-lg: 0 24px 60px rgba(11, 39, 69, .16);

  --proline-radius-sm: 12px;
  --proline-radius-md: 18px;
  --proline-radius-lg: 26px;
  --proline-radius-xl: 32px;
}

/* ------------------------------------------------------------
   BASE
   ------------------------------------------------------------ */

body {
  background:
    radial-gradient(
      circle at 10% 0%,
      rgba(79, 142, 209, .045),
      transparent 30%
    ),
    var(--proline-paper);
  color: var(--proline-navy);
}

::selection {
  background: var(--proline-blue-light);
  color: var(--proline-navy);
}

a {
  -webkit-tap-highlight-color: transparent;
}

/* ------------------------------------------------------------
   ACCESSIBILITY / FOCUS
   ------------------------------------------------------------ */

:where(
  a,
  button,
  input,
  textarea,
  select,
  [tabindex]
):focus-visible {
  outline: 2px solid var(--proline-blue);
  outline-offset: 3px;
}

/* ------------------------------------------------------------
   BOUTONS â€” harmonisation bleue
   ------------------------------------------------------------ */

.btn-solid {
  background:
    linear-gradient(
      135deg,
      var(--proline-blue),
      var(--proline-blue-dark)
    );
  box-shadow: 0 10px 26px rgba(79, 142, 209, .20);
}

.btn-solid:hover {
  box-shadow: 0 16px 34px rgba(79, 142, 209, .30);
}

.btn-outline {
  border-color: rgba(255, 255, 255, .38);
}

.btn-outline:hover {
  border-color: var(--proline-blue-light);
  background: rgba(79, 142, 209, .12);
}

/* ------------------------------------------------------------
   CTA PILL
   ------------------------------------------------------------ */

.cta-pill {
  background: linear-gradient(
    135deg,
    var(--proline-blue-light),
    var(--proline-blue)
  );
  color: var(--proline-navy);
  box-shadow: 0 8px 22px rgba(79, 142, 209, .18);
}

.cta-pill:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(79, 142, 209, .26);
}

/* ------------------------------------------------------------
   NAVIGATION
   ------------------------------------------------------------ */

header {
  background: rgba(11, 39, 69, .56);
  border-bottom-color: rgba(255, 255, 255, .10);
}

header.scrolled {
  background: rgba(11, 39, 69, .94);
}

.brand-text span {
  color: var(--proline-blue-light);
}

nav.links a:hover {
  color: var(--proline-white);
}

#nav-indicator {
  background:
    linear-gradient(
      90deg,
      var(--proline-blue-light),
      var(--proline-blue)
    );
}

/* ------------------------------------------------------------
   HERO
   ------------------------------------------------------------ */

#hero {
  background: var(--proline-navy);
}

#hero .photo-frame .tint {
  background:
    linear-gradient(
      135deg,
      rgba(11, 39, 69, .82),
      rgba(22, 61, 104, .60)
    );
}

.hero-headline .right {
  color: var(--proline-blue-light);
}

.hero-script {
  color: var(--proline-blue-light);
}

.hero-divider {
  background:
    linear-gradient(
      90deg,
      transparent,
      var(--proline-blue-light),
      transparent
    );
}

.eyebrow {
  color: var(--proline-blue-light);
}

/* ------------------------------------------------------------
   LOADER
   ------------------------------------------------------------ */

#loader {
  background:
    radial-gradient(
      circle at center,
      var(--proline-navy-2),
      var(--proline-navy) 70%
    );
}

#loader .blocks i:nth-child(1) {
  background: var(--proline-blue);
}

#loader .blocks i:nth-child(2) {
  background: var(--proline-blue-dark);
}

#loader .blocks i:nth-child(3) {
  background: var(--proline-blue-light);
}

#loader .blocks i:nth-child(4) {
  background: var(--proline-lavender);
}

#loader .bar span {
  background: var(--proline-blue-light);
}

/* ------------------------------------------------------------
   MARQUEE / SECTIONS SOMBRES
   ------------------------------------------------------------ */

.marquee-wrap {
  background: var(--proline-navy-2);
}

#stats,
#process,
#faq {
  background:
    radial-gradient(
      circle at 85% 15%,
      rgba(79, 142, 209, .10),
      transparent 35%
    ),
    var(--proline-navy);
}

.section-eyebrow {
  color: var(--proline-blue-dark);
}

#process .section-eyebrow,
#faq .section-eyebrow {
  color: var(--proline-blue-light);
}

/* ------------------------------------------------------------
   STATISTIQUES
   ------------------------------------------------------------ */

.stat .num span,
.stats-extra-number {
  color: var(--proline-blue-light);
}

/* ------------------------------------------------------------
   CARDS
   ------------------------------------------------------------ */

.value-card,
.card-face,
.catalogue-front,
.catalogue-back,
.hslide-col {
  border-color: var(--proline-border);
}

.value-card,
.catalogue-front,
.hslide-col {
  box-shadow: var(--proline-shadow-sm);
}

.value-card:hover,
.hslide-col:hover {
  box-shadow: var(--proline-shadow-md);
}

.value-card .idx {
  color: var(--proline-blue-dark);
}

/* ------------------------------------------------------------
   CATALOGUE â€” surface principale
   ------------------------------------------------------------ */

#catalogue,
#product-3d,
#gallery-alt {
  background:
    radial-gradient(
      circle at 5% 0%,
      rgba(79, 142, 209, .06),
      transparent 30%
    ),
    var(--proline-paper);
}

.catalogue-eyebrow {
  background: rgba(79, 142, 209, .10);
  color: var(--proline-blue-dark);
}

.catalogue-head h2 {
  color: var(--proline-navy);
}

.catalogue-head h2 span {
  color: var(--proline-blue);
}

.catalogue-filter:hover {
  border-color: var(--proline-blue);
  box-shadow: 0 8px 22px rgba(11, 39, 69, .10);
}

.catalogue-filter.is-active {
  background:
    linear-gradient(
      135deg,
      var(--proline-blue),
      var(--proline-blue-dark)
    );
}

/* ------------------------------------------------------------
   PRODUCT CARDS
   ------------------------------------------------------------ */

.product-card,
.catalogue-card {
  --card-color: var(--proline-blue);
}

.card-face .code {
  color: var(--proline-blue-dark);
}

.catalogue-category {
  background: var(--card-color) !important;
}

.catalogue-code {
  background: rgba(11, 39, 69, .94) !important;
}

.catalogue-meta strong,
.catalogue-hint {
  color: var(--card-color);
}

/* ------------------------------------------------------------
   CATEGORIES â€” cohÃ©rence globale
   ------------------------------------------------------------ */

.cat-banner,
.product-card,
.hslide-col,
.cat-filter-btn {
  transition:
    transform .35s cubic-bezier(.2,.8,.2,1),
    box-shadow .35s ease,
    border-color .25s ease;
}

.cat-banner:hover {
  box-shadow:
    0 24px 55px color-mix(
      in srgb,
      var(--cat) 28%,
      transparent
    );
}

/* ------------------------------------------------------------
   CATEGORY COLORS
   ------------------------------------------------------------ */

.cat-banner.cuisine,
.cat-banner[data-category="cuisine"],
.product-card.cuisine,
.product-card[data-category="cuisine"],
.hslide-col.cuisine,
.hslide-col[data-category="cuisine"] {
  --cat: var(--color-cat-cuisine);
  --cat-light: var(--color-cat-cuisine-light);
  --cat-dark: var(--color-cat-cuisine-dark);
}

.cat-banner.machine,
.cat-banner[data-category="machine"],
.product-card.machine,
.product-card[data-category="machine"],
.hslide-col.machine,
.hslide-col[data-category="machine"] {
  --cat: var(--color-cat-machine);
  --cat-light: var(--color-cat-machine-light);
  --cat-dark: var(--color-cat-machine-dark);
}

.cat-banner.buanderie,
.cat-banner[data-category="buanderie"],
.product-card.buanderie,
.product-card[data-category="buanderie"],
.hslide-col.buanderie,
.hslide-col[data-category="buanderie"] {
  --cat: var(--color-cat-buanderie);
  --cat-light: var(--color-cat-buanderie-light);
  --cat-dark: var(--color-cat-buanderie-dark);
}

.cat-banner.sanitaire,
.cat-banner[data-category="sanitaire"],
.product-card.sanitaire,
.product-card[data-category="sanitaire"],
.hslide-col.sanitaire,
.hslide-col[data-category="sanitaire"] {
  --cat: var(--color-cat-sanitaire);
  --cat-light: var(--color-cat-sanitaire-light);
  --cat-dark: var(--color-cat-sanitaire-dark);
}

.cat-banner.communs,
.cat-banner[data-category="communs"],
.product-card.communs,
.product-card[data-category="communs"],
.hslide-col.communs,
.hslide-col[data-category="communs"] {
  --cat: var(--color-cat-communs);
  --cat-light: var(--color-cat-communs-light);
  --cat-dark: var(--color-cat-communs-dark);
}

.cat-banner.piscine,
.cat-banner[data-category="piscine"],
.product-card.piscine,
.product-card[data-category="piscine"],
.hslide-col.piscine,
.hslide-col[data-category="piscine"] {
  --cat: var(--color-cat-piscine);
  --cat-light: var(--color-cat-piscine-light);
  --cat-dark: var(--color-cat-piscine-dark);
}

/* ------------------------------------------------------------
   TIMELINE
   ------------------------------------------------------------ */

.timeline .line-fill {
  background:
    linear-gradient(
      90deg,
      var(--proline-blue-light),
      var(--proline-blue)
    );
}

.tl-node.active .dot {
  border-color: var(--proline-blue-light);
  background: var(--proline-blue-light);
  box-shadow:
    0 0 24px rgba(79, 142, 209, .45);
}

/* ------------------------------------------------------------
   SPOTLIGHT PRODUIT
   ------------------------------------------------------------ */

.spotlight-visual {
  background:
    radial-gradient(
      120% 120% at 30% 20%,
      #214d78 0%,
      var(--proline-navy) 70%
    );
}

.spotlight-glow {
  background:
    radial-gradient(
      circle,
      rgba(79, 142, 209, .32),
      transparent 70%
    );
}

.spotlight-list li::before {
  color: var(--proline-blue);
}

.spotlight-tags span {
  background: rgba(79, 142, 209, .08);
  color: var(--proline-blue-dark);
  border-color: rgba(79, 142, 209, .18);
}

/* ------------------------------------------------------------
   GALLERY
   ------------------------------------------------------------ */

.gslide-pin {
  background:
    radial-gradient(
      circle at 80% 20%,
      rgba(79, 142, 209, .10),
      transparent 35%
    ),
    var(--proline-navy);
}

.gslide-caption .idx {
  color: var(--proline-blue-light);
}

/* ------------------------------------------------------------
   MOBILE NAV
   ------------------------------------------------------------ */

.mobile-nav {
  background:
    linear-gradient(
      145deg,
      var(--proline-navy-2),
      var(--proline-navy)
    );
}

.mobile-nav a:hover {
  background: rgba(79, 142, 209, .12);
  color: var(--proline-blue-light);
}

/* ------------------------------------------------------------
   FOOTER
   ------------------------------------------------------------ */

footer {
  background:
    linear-gradient(
      145deg,
      var(--proline-navy-2),
      var(--proline-navy)
    );
}

.footer-grid a:hover {
  color: var(--proline-blue-light);
}

.newsletter button,
.newsletter button[type="submit"] {
  background:
    linear-gradient(
      135deg,
      var(--proline-blue-light),
      var(--proline-blue)
    );
  color: var(--proline-navy);
}

/* ------------------------------------------------------------
   WHATSAPP / ACTION FLOAT
   ------------------------------------------------------------ */

.proline-whatsapp {
  box-shadow:
    0 12px 30px rgba(11, 39, 69, .22);
}

/* ------------------------------------------------------------
   IMAGES â€” rendu premium
   ------------------------------------------------------------ */

.photo-frame img,
.catalogue-image img,
.gslide-col img {
  image-rendering: auto;
}

/* ------------------------------------------------------------
   REDUCTION MOTION
   ------------------------------------------------------------ */

@media (prefers-reduced-motion: reduce) {
  .cat-banner,
  .product-card,
  .catalogue-card,
  .btn-solid,
  .btn-outline,
  .cta-pill,
  .gslide-col img {
    transition: none !important;
  }
}

/* ------------------------------------------------------------
   RESPONSIVE FINAL
   ------------------------------------------------------------ */

@media (max-width: 900px) {
  section {
    padding-left: 6vw;
    padding-right: 6vw;
  }

  #cta-banner {
    margin-left: 6vw;
    margin-right: 6vw;
  }
}

@media (max-width: 600px) {
  section {
    padding-top: 78px;
    padding-bottom: 78px;
  }

  .hero-headline {
    font-size: clamp(42px, 14vw, 72px);
  }

  .hero-sub {
    font-size: 15px;
  }

  .hero-ctas {
    width: 100%;
  }

  .hero-ctas > * {
    width: min(100%, 320px);
  }

  .catalogue-card {
    border-radius: 20px;
  }

  .catalogue-front,
  .catalogue-back {
    border-radius: 20px;
  }
}













