/* PROLINE LAB - ANALYSE GLOBALS.CSS */
/* ================================================================
   PROLINE LAB â€” FINAL BLUE HARMONIZATION LAYER
/*  */
   Objectif :
   - Harmoniser l'ensemble du site avec la nouvelle identitÃ© bleue.
   - Conserver toutes les classes et animations existantes.
   - Ne supprimer aucune rÃ¨gle existante.
   - Unifier les interactions, surfaces, boutons, cartes et catÃ©gories.
   - Renforcer le responsive et l'accessibilitÃ©.
   ================================================================ */


/* ================================================================
   01 â€” DESIGN TOKENS
   ================================================================ */

:root {
  /* ---------- Core ---------- */
  --proline-blue-950: #071D33;
  --proline-blue-900: #0B2745;
  --proline-blue-850: #103453;
  --proline-blue-800: #163D68;
  --proline-blue-700: #24527F;
  --proline-blue-600: #315F91;
  --proline-blue-500: #4F8ED1;
  --proline-blue-400: #6FA7D8;
  --proline-blue-300: #8AA8C4;
  --proline-blue-200: #B8CDE0;
  --proline-blue-100: #E4EEF7;
  --proline-blue-50: #F3F8FC;

  /* ---------- Neutral ---------- */
  --proline-white: #FFFFFF;
  --proline-paper: #F7FAFC;
  --proline-surface: #FFFFFF;
  --proline-surface-soft: #EEF5FA;
  --proline-border: rgba(11, 39, 69, .10);
  --proline-border-strong: rgba(11, 39, 69, .16);

  --proline-text: #16324F;
  --proline-text-soft: #60788F;
  --proline-text-muted: #7890A5;

  /* ---------- Effects ---------- */
  --proline-shadow-xs:
    0 1px 2px rgba(11, 39, 69, .05);

  --proline-shadow-sm:
    0 8px 24px rgba(11, 39, 69, .08);

  --proline-shadow-md:
    0 18px 45px rgba(11, 39, 69, .12);

  --proline-shadow-lg:
    0 28px 70px rgba(11, 39, 69, .16);

  --proline-radius-sm: 10px;
  --proline-radius-md: 16px;
  --proline-radius-lg: 22px;
  --proline-radius-xl: 28px;
  --proline-radius-pill: 999px;

  /* ---------- Motion ---------- */
  --proline-ease:
    cubic-bezier(.16, 1, .3, 1);

  --proline-transition-fast:
    .2s var(--proline-ease);

  --proline-transition:
    .35s var(--proline-ease);

  --proline-transition-slow:
    .6s var(--proline-ease);
}


/* ================================================================
   02 â€” GLOBAL BASE HARMONIZATION
   ================================================================ */

html {
  background: var(--proline-paper);
  color-scheme: light;
}

body {
  background:
    radial-gradient(
      circle at 10% 0%,
      rgba(79, 142, 209, .045),
      transparent 30%
    ),
    var(--proline-paper);

  color: var(--proline-text);
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

::selection {
  background: var(--proline-blue-500);
  color: #fff;
}

a {
  -webkit-tap-highlight-color: transparent;
}

button,
a,
input,
textarea,
select {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 3px solid rgba(79, 142, 209, .35);
  outline-offset: 3px;
}


/* ================================================================
   03 â€” GLOBAL IMAGE SAFETY
   ================================================================ */

img {
  max-width: 100%;
}

video {
  max-width: 100%;
}

picture {
  display: block;
}


/* ================================================================
   04 â€” HEADER / NAVIGATION
   ================================================================ */

header {
  background:
    linear-gradient(
      180deg,
      rgba(7, 29, 51, .82),
      rgba(11, 39, 69, .68)
    );

  border-bottom-color:
    rgba(255, 255, 255, .12);

  box-shadow:
    0 10px 30px rgba(7, 29, 51, .08);
}

header.scrolled {
  background:
    rgba(11, 39, 69, .94);

  box-shadow:
    0 14px 35px rgba(7, 29, 51, .18);
}

.brand-text span {
  color: var(--proline-blue-400);
}

nav.links a {
  transition:
    color var(--proline-transition-fast),
    opacity var(--proline-transition-fast);
}

nav.links a:hover {
  color: #fff;
}


/* ================================================================
   05 â€” BUTTON SYSTEM
   ================================================================ */

.btn-solid {
  background:
    linear-gradient(
      135deg,
      var(--proline-blue-500),
      var(--proline-blue-600)
    );

  box-shadow:
    0 10px 24px rgba(79, 142, 209, .20);

  transition:
    transform var(--proline-transition),
    box-shadow var(--proline-transition),
    filter var(--proline-transition-fast);
}

.btn-solid:hover {
  transform:
    translateY(-3px)
    scale(1.025);

  box-shadow:
    0 18px 36px rgba(79, 142, 209, .30);

  filter: brightness(1.04);
}

.btn-solid:active {
  transform:
    translateY(-1px)
    scale(.99);
}

.btn-outline {
  border-color:
    rgba(255, 255, 255, .38);

  transition:
    transform var(--proline-transition),
    background var(--proline-transition),
    border-color var(--proline-transition),
    box-shadow var(--proline-transition);
}

.btn-outline:hover {
  background:
    rgba(79, 142, 209, .16);

  border-color:
    rgba(255, 255, 255, .72);

  box-shadow:
    0 10px 28px rgba(0, 0, 0, .12);
}


/* ================================================================
   06 â€” CTA PILL
   ================================================================ */

.cta-pill {
  background:
    linear-gradient(
      135deg,
      var(--proline-blue-400),
      var(--proline-blue-500)
    );

  color: var(--proline-blue-950);

  box-shadow:
    0 8px 22px rgba(79, 142, 209, .20);

  transition:
    transform var(--proline-transition),
    box-shadow var(--proline-transition),
    filter var(--proline-transition-fast);
}

.cta-pill:hover {
  transform: translateY(-2px);
  box-shadow:
    0 14px 30px rgba(79, 142, 209, .28);

  filter: brightness(1.04);
}


/* ================================================================
   07 â€” SECTION SYSTEM
   ================================================================ */

section {
  position: relative;
}

.section-eyebrow,
.catalogue-eyebrow {
  color: var(--proline-blue-600);
}

.section-title {
  color: var(--proline-text);
}

.section-sub {
  color: var(--proline-text-soft);
}


/* Sections sombres */

#stats,
#process,
#faq {
  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(79, 142, 209, .10),
      transparent 35%
    ),
    linear-gradient(
      145deg,
      var(--proline-blue-950),
      var(--proline-blue-900)
    );
}


/* ================================================================
   08 â€” HERO BLUE SYSTEM
   ================================================================ */

#hero {
  background:
    linear-gradient(
      135deg,
      var(--proline-blue-950),
      var(--proline-blue-900)
    );
}

#hero .photo-frame .tint {
  background:
    linear-gradient(
      135deg,
      rgba(7, 29, 51, .82),
      rgba(11, 39, 69, .58)
    );
}

.hero-headline .right {
  color: var(--proline-blue-400);
}

.hero-script {
  color: var(--proline-blue-400);
}

.hero-divider {
  background:
    linear-gradient(
      90deg,
      transparent,
      var(--proline-blue-400),
      transparent
    );
}

.hero-video {
  filter:
    grayscale(.10)
    contrast(1.04)
    saturate(.94)
    brightness(.92);
}


/* ================================================================
   09 â€” LOADER
   ================================================================ */

#loader {
  background:
    radial-gradient(
      circle at center,
      var(--proline-blue-800),
      var(--proline-blue-950) 72%
    );
}

#loader .blocks i:nth-child(1) {
  background: var(--proline-blue-300);
}

#loader .blocks i:nth-child(2) {
  background: var(--proline-blue-500);
}

#loader .blocks i:nth-child(3) {
  background: var(--proline-blue-400);
}

#loader .blocks i:nth-child(4) {
  background: var(--proline-blue-200);
}

#loader .bar span {
  background:
    linear-gradient(
      90deg,
      var(--proline-blue-300),
      var(--proline-blue-500)
    );
}


/* ================================================================
   10 â€” SPOTLIGHT / GLOW
   ================================================================ */

#spotlight {
  background:
    radial-gradient(
      circle,
      rgba(79, 142, 209, .16),
      rgba(79, 142, 209, .04) 40%,
      transparent 72%
    );
}

.spotlight-visual {
  background:
    radial-gradient(
      120% 120% at 30% 20%,
      var(--proline-blue-800) 0%,
      var(--proline-blue-950) 72%
    );
}

.spotlight-glow {
  background:
    radial-gradient(
      circle,
      rgba(79, 142, 209, .38),
      transparent 70%
    );
}

.spotlight-tags span {
  background:
    rgba(79, 142, 209, .08);

  color:
    var(--proline-blue-600);

  border-color:
    rgba(79, 142, 209, .18);
}

.spotlight-list li::before {
  color: var(--proline-blue-500);
}


/* ================================================================
   11 â€” ABOUT / VALUE CARDS
   ================================================================ */

.value-card {
  background: rgba(255, 255, 255, .92);
  border-color: var(--proline-border);
  box-shadow: var(--proline-shadow-xs);

  transition:
    transform var(--proline-transition),
    box-shadow var(--proline-transition),
    border-color var(--proline-transition);
}

.value-card:hover {
  transform: translateY(-6px);

  border-color:
    rgba(79, 142, 209, .22);

  box-shadow:
    var(--proline-shadow-md);
}

.value-card .idx {
  color: var(--proline-blue-500);
}


/* ================================================================
   12 â€” CATEGORY COLOR SYSTEM
   ================================================================ */

/*
   Chaque catÃ©gorie conserve sa propre identitÃ©,
   mais toutes appartiennent dÃ©sormais Ã  la mÃªme famille bleue.
*/

.cat-banner.cuisine,
.cat-banner[data-category="cuisine"],
.product-card.cuisine,
.product-card[data-category="cuisine"],
.hslide-col.cuisine,
.hslide-col[data-category="cuisine"],
.cat-filter-btn.cuisine,
.cat-filter-btn[data-category="cuisine"] {
  --cat: var(--color-cat-cuisine);
  --cat-light: var(--color-cat-cuisine-light);
  --cat-dark: var(--color-cat-cuisine-dark);
}

.cat-banner.machine,
.cat-banner[data-category="machine"],
.product-card.machine,
.product-card[data-category="machine"],
.hslide-col.machine,
.hslide-col[data-category="machine"],
.cat-filter-btn.machine,
.cat-filter-btn[data-category="machine"] {
  --cat: var(--color-cat-machine);
  --cat-light: var(--color-cat-machine-light);
  --cat-dark: var(--color-cat-machine-dark);
}

.cat-banner.buanderie,
.cat-banner[data-category="buanderie"],
.product-card.buanderie,
.product-card[data-category="buanderie"],
.hslide-col.buanderie,
.hslide-col[data-category="buanderie"],
.cat-filter-btn.buanderie,
.cat-filter-btn[data-category="buanderie"] {
  --cat: var(--color-cat-buanderie);
  --cat-light: var(--color-cat-buanderie-light);
  --cat-dark: var(--color-cat-buanderie-dark);
}

.cat-banner.sanitaire,
.cat-banner[data-category="sanitaire"],
.product-card.sanitaire,
.product-card[data-category="sanitaire"],
.hslide-col.sanitaire,
.hslide-col[data-category="sanitaire"],
.cat-filter-btn.sanitaire,
.cat-filter-btn[data-category="sanitaire"] {
  --cat: var(--color-cat-sanitaire);
  --cat-light: var(--color-cat-sanitaire-light);
  --cat-dark: var(--color-cat-sanitaire-dark);
}

.cat-banner.communs,
.cat-banner[data-category="communs"],
.product-card.communs,
.product-card[data-category="communs"],
.hslide-col.communs,
.hslide-col[data-category="communs"],
.cat-filter-btn.communs,
.cat-filter-btn[data-category="communs"] {
  --cat: var(--color-cat-communs);
  --cat-light: var(--color-cat-communs-light);
  --cat-dark: var(--color-cat-communs-dark);
}

.cat-banner.piscine,
.cat-banner[data-category="piscine"],
.product-card.piscine,
.product-card[data-category="piscine"],
.hslide-col.piscine,
.hslide-col[data-category="piscine"],
.cat-filter-btn.piscine,
.cat-filter-btn[data-category="piscine"] {
  --cat: var(--color-cat-piscine);
  --cat-light: var(--color-cat-piscine-light);
  --cat-dark: var(--color-cat-piscine-dark);
}


/* ================================================================
   13 â€” CATEGORY BANNERS
   ================================================================ */

.cat-banner {
  border:
    1px solid rgba(255, 255, 255, .12);

  box-shadow:
    0 20px 45px
    color-mix(
      in srgb,
      var(--cat) 20%,
      transparent
    );

  transition:
    transform var(--proline-transition),
    box-shadow var(--proline-transition),
    filter var(--proline-transition-fast);
}

.cat-banner:hover {
  filter: brightness(1.035);
  box-shadow:
    0 28px 58px
    color-mix(
      in srgb,
      var(--cat) 28%,
      transparent
    );
}

.cat-banner .label h3 {
  letter-spacing: -.02em;
}

.category-name {
  color: var(--proline-blue-900);
}

.category-ref {
  background:
    rgba(7, 29, 51, .88);
}


/* ================================================================
   14 â€” CATEGORY FILTERS
   ================================================================ */

.cat-filter-btn,
.catalogue-filter {
  color: var(--proline-text-soft);
  border-color: var(--proline-border-strong);
  background: rgba(255, 255, 255, .92);

  transition:
    transform var(--proline-transition-fast),
    background var(--proline-transition-fast),
    border-color var(--proline-transition-fast),
    color var(--proline-transition-fast),
    box-shadow var(--proline-transition-fast);
}

.cat-filter-btn:hover,
.catalogue-filter:hover {
  transform: translateY(-2px);

  border-color:
    var(--cat, var(--proline-blue-500));

  color:
    var(--cat-dark, var(--proline-blue-600));

  background:
    var(--cat-light, var(--proline-blue-100));

  box-shadow:
    0 8px 22px rgba(11, 39, 69, .08);
}

.cat-filter-btn.active,
.catalogue-filter.is-active {
  background:
    linear-gradient(
      135deg,
      var(--cat, var(--proline-blue-500)),
      var(--cat-dark, var(--proline-blue-600))
    );

  border-color:
    var(--cat, var(--proline-blue-500));

  color: #fff;

  box-shadow:
    0 10px 26px
    color-mix(
      in srgb,
      var(--cat, var(--proline-blue-500)) 28%,
      transparent
    );
}


/* ================================================================
   15 â€” PRODUCT CARDS
   ================================================================ */

.product-card {
  --cat: var(--proline-blue-500);
}

.card-face {
  border-color:
    rgba(11, 39, 69, .08);

  box-shadow:
    var(--proline-shadow-sm);
}

.card-face .code {
  color: var(--cat);
}

.card-face .name {
  color: var(--proline-text);
}

.card-face .desc {
  color: var(--proline-text-soft);
}

.card-face.back {
  background:
    linear-gradient(
      145deg,
      var(--cat),
      var(--cat-dark, var(--proline-blue-600))
    );
}


/* ================================================================
   16 â€” NEW CATALOGUE CARDS
   ================================================================ */

.proline-catalogue {
  background:
    radial-gradient(
      circle at 10% 10%,
      rgba(79, 142, 209, .10),
      transparent 35%
    ),
    radial-gradient(
      circle at 90% 90%,
      rgba(49, 95, 145, .07),
      transparent 35%
    ),
    var(--proline-paper);
}

.catalogue-card {
  --card-color: var(--proline-blue-500);
}

.catalogue-front,
.catalogue-back {
  border-color:
    rgba(11, 39, 69, .08);

  box-shadow:
    var(--proline-shadow-md);
}

.catalogue-front {
  transition:
    box-shadow var(--proline-transition),
    transform var(--proline-transition);
}

.catalogue-card:hover .catalogue-front,
.catalogue-card:hover .catalogue-back {
  box-shadow:
    var(--proline-shadow-lg);
}

.catalogue-image {
  background:
    var(--proline-surface-soft);
}

.catalogue-content h3 {
  color:
    var(--proline-blue-900);
}

.catalogue-meta {
  background:
    var(--proline-blue-50);

  border-color:
    rgba(11, 39, 69, .07);
}

.catalogue-content p {
  color:
    var(--proline-text-soft);
}

.catalogue-hint {
  color:
    var(--card-color);
}


/* ================================================================
   17 â€” CATEGORY BADGES
   ================================================================ */

.catalogue-category {
  background:
    var(--card-color) !important;

  box-shadow:
    0 8px 18px rgba(7, 29, 51, .18);
}

.catalogue-code {
  background:
    rgba(7, 29, 51, .90) !important;
}

.back-category {
  background:
    rgba(255, 255, 255, .08);
}


/* ================================================================
   18 â€” HORIZONTAL SLIDER
   ================================================================ */

.hslide-pin {
  background:
    linear-gradient(
      180deg,
      var(--proline-paper),
      var(--proline-blue-50)
    );
}

.hslide-col {
  border-color:
    rgba(11, 39, 69, .08);

  box-shadow:
    var(--proline-shadow-xs);

  transition:
    transform var(--proline-transition),
    box-shadow var(--proline-transition),
    border-color var(--proline-transition);
}

.hslide-col:hover {
  box-shadow:
    var(--proline-shadow-lg);

  border-color:
    color-mix(
      in srgb,
      var(--c) 30%,
      transparent
    );
}

.hslide-num {
  color:
    var(--c);
}


/* ================================================================
   19 â€” GALLERY
   ================================================================ */

.gslide-pin {
  background:
    linear-gradient(
      145deg,
      var(--proline-blue-950),
      var(--proline-blue-900)
    );
}

.gslide-col {
  box-shadow:
    0 24px 55px rgba(7, 29, 51, .32);
}

.gslide-col::after {
  background:
    linear-gradient(
      180deg,
      rgba(7, 29, 51, 0),
      rgba(7, 29, 51, .90)
    );
}

.gslide-caption .idx {
  color:
    var(--proline-blue-300);
}


/* ================================================================
   20 â€” TIMELINE
   ================================================================ */

.timeline .line-fill {
  background:
    linear-gradient(
      90deg,
      var(--proline-blue-300),
      var(--proline-blue-500)
    );
}

.tl-node.active .dot {
  border-color:
    var(--proline-blue-400);

  background:
    var(--proline-blue-500);

  box-shadow:
    0 0 26px rgba(79, 142, 209, .45);
}


/* ================================================================
   21 â€” CTA BANNER
   ================================================================ */

#cta-banner .tint {
  background:
    linear-gradient(
      135deg,
      rgba(7, 29, 51, .90),
      rgba(11, 39, 69, .76)
    );
}


/* ================================================================
   22 â€” MOBILE NAV
   ================================================================ */

.mobile-nav {
  background:
    rgba(11, 39, 69, .97);

  border-color:
    rgba(255, 255, 255, .12);

  box-shadow:
    0 22px 55px rgba(7, 29, 51, .35);
}

.mobile-nav a:hover {
  background:
    rgba(79, 142, 209, .12);

  color:
    var(--proline-blue-300);
}


/* ================================================================
   23 â€” FOOTER
   ================================================================ */

footer {
  background:
    linear-gradient(
      145deg,
      var(--proline-blue-950),
      var(--proline-blue-900)
    );
}

.footer-grid a:hover {
  color:
    var(--proline-blue-300);
}

.newsletter {
  border-color:
    rgba(255, 255, 255, .14);
}

.newsletter button,
.newsletter button[type="submit"] {
  background:
    linear-gradient(
      135deg,
      var(--proline-blue-300),
      var(--proline-blue-500)
    );

  color:
    var(--proline-blue-950);
}


/* ================================================================
   24 â€” FAQ
   ================================================================ */

#faq {
  overflow: hidden;
}

.faq-list {
  color:
    rgba(255, 255, 255, .76);
}

.faq-list p {
  color:
    rgba(255, 255, 255, .68);
}


/* ================================================================
   25 â€” 3D INTERACTIONS
   ================================================================ */

.tilt-target,
.spotlight-visual,
.gslide-col,
.catalogue-card,
.product-card {
  -webkit-transform-style: preserve-3d;
  transform-style: preserve-3d;
}

.tilt-target::before,
.spotlight-visual::before {
  background:
    radial-gradient(
      260px circle at var(--mx) var(--my),
      rgba(255, 255, 255, .24),
      transparent 62%
    );
}


/* ================================================================
   26 â€” MICRO INTERACTIONS
   ================================================================ */

.arrow-badge,
.service-arrow {
  transition:
    transform var(--proline-transition),
    opacity var(--proline-transition-fast),
    background var(--proline-transition-fast);
}

.service-card:hover .service-arrow {
  transform: translateX(5px);
}

.category-link {
  transition:
    transform var(--proline-transition),
    color var(--proline-transition-fast);
}

.category-link:hover {
  transform: translateY(-2px);
}


/* ================================================================
   27 â€” BADGES / LABELS
   ================================================================ */

.badge-clean .ring {
  border-color:
    var(--proline-blue-400);

  animation:
    pulseRingBlue 2.4s ease-in-out infinite;
}

@keyframes pulseRingBlue {
  0%, 100% {
    box-shadow:
      0 0 0 0 rgba(79, 142, 209, .30);
  }

  50% {
    box-shadow:
      0 0 0 10px rgba(79, 142, 209, 0);
  }
}


/* ================================================================
   28 â€” MARQUEE
   ================================================================ */

.marquee-wrap {
  background:
    linear-gradient(
      90deg,
      var(--proline-blue-950),
      var(--proline-blue-800),
      var(--proline-blue-950)
    );
}

.marquee span {
  color:
    rgba(255, 255, 255, .62);
}


/* ================================================================
   29 â€” SCROLL CUE
   ================================================================ */

.scroll-cue {
  border-color:
    rgba(255, 255, 255, .30);

  box-shadow:
    0 8px 22px rgba(0, 0, 0, .10);
}


/* ================================================================
   30 â€” GENERIC SERVICE CARDS
   ================================================================ */

.service-card {
  border-radius:
    var(--proline-radius-lg);

  transition:
    transform var(--proline-transition),
    box-shadow var(--proline-transition),
    border-color var(--proline-transition);
}

.service-card:hover {
  transform:
    translateY(-6px);

  box-shadow:
    var(--proline-shadow-md);
}


/* ================================================================
   31 â€” PHOTO SECTIONS
   ================================================================ */

.section-photo {
  box-shadow:
    var(--proline-shadow-md);
}

.section-photo::after {
  background:
    linear-gradient(
      180deg,
      transparent 30%,
      rgba(7, 29, 51, .78) 100%
    );
}


/* ================================================================
   32 â€” RESPONSIVE GLOBAL HARMONIZATION
   ================================================================ */

@media (max-width: 1100px) {
  section {
    padding-left: 6vw;
    padding-right: 6vw;
  }

  .footer-grid {
    grid-template-columns:
      1.5fr 1fr 1fr;
  }
}

@media (max-width: 900px) {
  section {
    padding-top: 85px;
    padding-bottom: 85px;
  }

  .hero-headline {
    font-size:
      clamp(42px, 10vw, 82px);
  }

  .spotlight-wrap {
    gap: 40px;
  }

  .footer-grid {
    grid-template-columns:
      1fr 1fr;
  }
}

@media (max-width: 700px) {
  section {
    padding-left: 20px;
    padding-right: 20px;
  }

  .hero-sub {
    font-size: 15px;
  }

  .hero-ctas {
    width: 100%;
  }

  .hero-ctas a,
  .hero-ctas button {
    min-width: 180px;
  }

  .spotlight-visual {
    min-height: 320px;
    border-radius: 22px;
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }

  .footer-bottom {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 520px) {
  #hero {
    padding:
      110px 16px 65px;
  }

  .hero-headline {
    font-size:
      clamp(38px, 13vw, 62px);

    gap: .18em;
  }

  .hero-script {
    font-size: 22px;
  }

  .hero-ctas {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-ctas a,
  .hero-ctas button {
    width: 100%;
  }

  .btn-solid,
  .btn-outline {
    width: 100%;
  }

  .stats-grid {
    gap: 24px;
  }

  .value-card {
    padding: 24px 20px;
  }

  .catalogue-content {
    padding: 20px;
  }

  .catalogue-card {
    height: auto;
    min-height: 460px;
  }
}


/* ================================================================
   33 â€” TOUCH DEVICES
   ================================================================ */

@media (hover: none) and (pointer: coarse) {

  .btn-solid:hover,
  .btn-outline:hover,
  .cta-pill:hover,
  .value-card:hover,
  .service-card:hover,
  .cat-banner:hover {
    transform: none;
  }

  .cat-banner .arrow-badge {
    opacity: 1;
    transform: none;
  }

  .gslide-col:hover img {
    transform: scale(1.02);
  }
}


/* ================================================================
   34 â€” REDUCED MOTION
   ================================================================ */

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto !important;
  }

  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }

  .marquee {
    animation: none !important;
  }

  .scroll-cue {
    animation: none !important;
  }
}


/* ================================================================
   35 â€” CUSTOM SCROLLBAR
   ================================================================ */

* {
  scrollbar-width: thin;
  scrollbar-color:
    var(--proline-blue-300)
    var(--proline-blue-50);
}

::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

::-webkit-scrollbar-track {
  background:
    var(--proline-blue-50);
}

::-webkit-scrollbar-thumb {
  background:
    linear-gradient(
      180deg,
      var(--proline-blue-300),
      var(--proline-blue-500)
    );

  border:
    2px solid var(--proline-blue-50);

  border-radius:
    999px;
}

::-webkit-scrollbar-thumb:hover {
  background:
    var(--proline-blue-600);
}


/* ================================================================
   36 â€” SELECTION / TEXT DETAILS
   ================================================================ */

.hero-headline,
.section-title,
.catalogue-head h2 {
  text-wrap: balance;
}

.section-sub,
.catalogue-head p,
.catalogue-content p {
  text-wrap: pretty;
}


/* ================================================================
   37 â€” OVERFLOW SAFETY
   ================================================================ */

#hero,
#stats,
#about,
#process,
#faq,
#cta-banner,
#product-3d,
#gallery-alt,
#spotlight-product {
  isolation: isolate;
}

.cat-grid-banners,
.product-grid,
.catalogue-grid,
.values-grid,
.services-grid,
.stats-grid {
  min-width: 0;
}

.catalogue-card,
.product-card,
.value-card,
.service-card {
  min-width: 0;
}


/* ================================================================
   38 â€” FINAL BLUE IDENTITY OVERRIDES
/*  */
   Ces variables permettent aux anciennes classes de rester
   fonctionnelles tout en utilisant la nouvelle identitÃ©.
   ================================================================ */

:root {
  --color-green:
    var(--proline-blue-500);

  --color-green-light:
    var(--proline-blue-300);

  --color-yellow:
    var(--proline-blue-600);

  --color-red:
    var(--proline-blue-800);

  --color-blue:
    var(--proline-blue-500);

  --color-pink:
    var(--proline-blue-200);

  --color-navy:
    var(--proline-blue-900);

  --color-navy-2:
    var(--proline-blue-800);

  --color-paper:
    var(--proline-paper);

  --color-ink:
    var(--proline-text);

  --color-ink-soft:
    var(--proline-text-soft);
}


/* ================================================================
   39 â€” FINAL CATEGORY TOKENS
   ================================================================ */

:root {
  --color-cat-cuisine:
    #7896AE;

  --color-cat-cuisine-light:
    #E4EEF7;

  --color-cat-cuisine-dark:
    #526F91;

  --color-cat-machine:
    #5FAFC8;

  --color-cat-machine-light:
    #E4EEF7;

  --color-cat-machine-dark:
    #315F91;

  --color-cat-buanderie:
    #69C7E3;

  --color-cat-buanderie-light:
    #E4EEF7;

  --color-cat-buanderie-dark:
    #315F91;

  --color-cat-sanitaire:
    #899BC8;

  --color-cat-sanitaire-light:
    #E4EEF7;

  --color-cat-sanitaire-dark:
    #526F91;

  --color-cat-communs:
    #526F91;

  --color-cat-communs-light:
    #E4EEF7;

  --color-cat-communs-dark:
    #163D68;

  --color-cat-piscine:
    #4F8ED1;

  --color-cat-piscine-light:
    #E4EEF7;

  --color-cat-piscine-dark:
    #315F91;
}


/* ================================================================
   40 â€” END
   ================================================================ */
